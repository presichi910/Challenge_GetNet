      "username": "cliente1988",
      "enabled": true,
      "emailVerified": true,
      "firstName": "cliente1988",
      "lastName": "demo",
      "email": "cliente1988@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
