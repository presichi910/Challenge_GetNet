# keys
# GROQ_API_KEY: the agents when AGENT_PROVIDER=groq, and always the eval judge
GROQ_API_KEY=
# FIREWORKS_API_KEY: the agents when AGENT_PROVIDER=fireworks
FIREWORKS_API_KEY=
TAVILY_API_KEY=
VOYAGE_API_KEY=

# provider of the agents (router, knowledge, support, synthesizer, summarizer): fireworks (the evaluated configuration) or groq.
# fireworks uses its OpenAI-compatible API (https://api.fireworks.ai/inference/v1) with FIREWORKS_API_KEY.
# Fireworks serves gpt-oss-120b serverless but NOT gpt-oss-20b (it answers 404 "Model not found, inaccessible,
# and/or not deployed"), so with fireworks every role runs on the 120b. This is the configuration of the
# reports in eval/reports:
#   AGENT_PROVIDER=fireworks
#   LLM_MODEL=accounts/fireworks/models/gpt-oss-120b
#   LIGHT_MODEL=accounts/fireworks/models/gpt-oss-120b
#   SUPPORT_MODEL=accounts/fireworks/models/gpt-oss-120b
# The eval judge (JUDGE_MODEL) always runs on Groq (GROQ_API_KEY), whatever this says.
# docker-compose.yml defaults to this configuration. For Groq instead, set AGENT_PROVIDER=groq and the Groq model ids below.
AGENT_PROVIDER=fireworks
# FALLBACK_PROVIDER: the other provider that answers (same model, other id) when AGENT_PROVIDER has an outage: 5xx, 429, no
# connection, timeout. Needs that provider's key. Empty = no failover. docker compose sets groq for the api and "" for the eval.
FALLBACK_PROVIDER=groq

# models, one variable per role (docker-compose.yml passes them to the containers)
# LLM_MODEL: knowledge agent
# (Groq ids: openai/gpt-oss-120b, openai/gpt-oss-20b; Fireworks does not serve the 20b)
LLM_MODEL=accounts/fireworks/models/gpt-oss-120b
# LIGHT_MODEL: router and synthesizer
LIGHT_MODEL=accounts/fireworks/models/gpt-oss-120b
# SUPPORT_MODEL: support agent. Empty = same as LIGHT_MODEL. The 20b often skips get_recent_transactions
# on a declined payment and blames the terminal, the 120b does not. It shares the 120b quota
# with LLM_MODEL (Groq free tier: 8K tokens/min, 200K/day).
SUPPORT_MODEL=accounts/fireworks/models/gpt-oss-120b
REASONING_EFFORT=low
# JUDGE_MODEL: eval judge, use a different model family than the agents
JUDGE_MODEL=qwen/qwen3.8-27b
# Groq limits are per model. To run everything on one model set LLM_MODEL and LIGHT_MODEL to it
# (they then share one quota).
EMBEDDING_MODEL=voyage-3.5

# RAG
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=getnet_kb
RETRIEVAL_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Voyage free tier is ~3 requests/min. If you get 429s, keep these values.
# With a payment method on file: sleep 0, batch 128.
INGEST_BATCH_SIZE=16
INGEST_SLEEP_SECONDS=21

# auth: RS256 tokens checked against the identity provider's public keys (JWKS). There is NO shared secret.
# The API refuses to start unless all six are set, merchants and operators have different issuers and audiences,
# and the JWKS URLs are http(s). Docker compose runs Keycloak (infra/keycloak, two realms) and already passes these
# defaults to the api container; set them here only to use another identity provider.
#   JWKS_URL, JWT_ISSUER, JWT_AUDIENCE                       -> merchants (/chat, /conversations)
#   OPERATOR_JWKS_URL, OPERATOR_JWT_ISSUER, OPERATOR_JWT_AUDIENCE -> operators (/operator/*)
# The issuer is what the token says (the address a client used to reach the IdP); the JWKS URL is where the API fetches keys.
JWKS_URL=http://localhost:8180/realms/getnet-merchants/protocol/openid-connect/certs
JWT_ISSUER=http://localhost:8180/realms/getnet-merchants
JWT_AUDIENCE=getnet-support-api
OPERATOR_JWKS_URL=http://localhost:8180/realms/getnet-operators/protocol/openid-connect/certs
OPERATOR_JWT_ISSUER=http://localhost:8180/realms/getnet-operators
OPERATOR_JWT_AUDIENCE=getnet-operator-api
# a token that lives longer than this is refused, whatever the IdP issues
JWT_MAX_LIFETIME_SECONDS=900
# an unknown `kid` re-fetches the keys at most this often (so random kids cannot hammer the IdP)
JWKS_MIN_REFRESH_SECONDS=30
# revoked token ids survive a restart in this SQLite file (same volume as the others)
REVOCATIONS_DB_PATH=./data/revocations.sqlite
# requests per minute per authenticated caller (0 = no limit), in this process (the API runs one worker)
RATE_LIMIT_PER_MINUTE=30
OPERATOR_RATE_LIMIT_PER_MINUTE=120
# the demo identity provider of docker compose. Both are REQUIRED by compose and are never written in a file of the
# repo: any long random value (python -c "import secrets; print(secrets.token_urlsafe(24))").
KEYCLOAK_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# human handoff: the queue the operators work through (claim / reply). Its own file, apart from the
# conversation memory. HANDOFFS_FILE (jsonl) stays as an audit copy and is imported once into it.
HANDOFFS_DB_PATH=./data/handoffs.sqlite
# import the old queue file into the queue at startup (safe to leave on: records already there are
# skipped). Off by default: that file can hold test cases and old conversation excerpts. Back it up and
# clean it first, see the README, "Human oversight"
HANDOFF_IMPORT_JSONL=false
# an operator's claim holds this long; then the handoff is pending again (claiming again renews it)
HANDOFF_LEASE_MINUTES=15

# conversation memory: one SQLite file (in Docker it lives in the `data` volume)
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
# rolling summary: above this many messages the older ones are folded into a summary (LIGHT_MODEL).
# If the call fails or takes longer than the timeout, the turn goes on and the next turn retries.
SUMMARY_THRESHOLD=12
SUMMARY_TIMEOUT_SECONDS=20
# retention: the checkpoints hold customer data. A conversation idle for more than this many days is
# deleted (0 = never), at startup and every PURGE_INTERVAL_MINUTES.
THREAD_TTL_DAYS=30
PURGE_INTERVAL_MINUTES=60
# conversations per customer; a new one above the limit gets HTTP 429, nothing is deleted (0 = no limit)
MAX_THREADS_PER_USER=20

# observability: per-turn traces and spans (ids, tokens, cost, timings; never message text)
TRACES_DB_PATH=./data/traces.sqlite
# extra or corrected prices, JSON {model: [usd_per_1M_input, usd_per_1M_output]}; a model without a price
# is reported with cost null, never 0
MODEL_PRICES_JSON=
# a turn above either limit logs a WARNING line starting with "ALERT" (0 = off); a 429 always does
MAX_TURN_TOKENS=30000
MAX_TURN_COST_USD=0.02

# app
LOG_LEVEL=INFO

# after the answer is written (see the README, "How it works"):
# the answer may not repeat this many consecutive words of any system prompt (0 = guard off)
PROMPT_LEAK_MIN_WORDS=10
# statements (the verifier in production) or segments (evaluated, off: it flags too much)
VERIFIER_MODE=statements
# the observe step: 0 = off, 1 = retry the knowledge base once with the unsupported claims,
# 2 = ONE more action: add the support agent (the router sent only knowledge and an unsupported claim is about the customer's account),
#     or else offer a ticket or escalate when nothing actionable is left. Above 2 behaves exactly like 2.
REPLAN_MAX=0

# knowledge-base search (app/rag/hybrid.py): dense (default), hybrid (+BM25 and RRF) or hybrid_rerank (+Voyage reranker).
# The measured comparison and why dense stays the default are in the README (Results, Retrieval).
RAG_MODE=dense
# cache of query embeddings and rerank scores (a hash of the query, never its text); empty = no cache
RAG_CACHE_PATH=./data/rag_cache.sqlite

# a second ticket of the same category from the same customer within this many seconds is the same issue worded differently
# (a retried agent): the ticket already open is returned instead. 0 = only an identical summary counts
TICKET_DEDUP_WINDOW_S=600

# A ticket the agent asks for is opened only after a person approves it (/operator/approvals). The categories that need it
# (all of them by default; empty = no approval, the ticket opens at once) and how long a request may wait before it expires:
# no ticket is opened and the case goes to the human queue
APPROVAL_REQUIRED_CATEGORIES=terminal,payout,billing,account,other
APPROVAL_TTL_MINUTES=60

# Push to the operators (app/webhook.py): a signed HTTPS POST per new handoff, per ticket request waiting for approval and per handoff past its SLA.
# No customer text goes out. Empty URL = off. The key signs every request (X-Getnet-Signature); required with a URL.
WEBHOOK_URL=
WEBHOOK_SIGNING_KEY=
# a handoff nobody claims within this many minutes is escalated once (priority high, audit event, webhook); 0 = off
HANDOFF_SLA_MINUTES=30

# Observability (app/telemetry.py). METRICS_TOKEN: GET /metrics needs it as a bearer (empty = no endpoint); put the same value in
# infra/observability/metrics_token for Prometheus. OTLP_ENDPOINT: one trace per turn (docker compose --profile observability: http://jaeger:4317).
METRICS_TOKEN=
OTLP_ENDPOINT=
# GRAFANA_ADMIN_PASSWORD=   # only for `docker compose --profile observability`
